   itens[29] <- "Burguer picante"
   precos[29] <- 24.00
   itens[30] <- "Burguer kids"
   precos[30] <- 13.00

   // Porcoes
   itens[31] <- "Batata frita pequena"
   precos[31] <- 8.00
   itens[32] <- "Batata frita media"
   precos[32] <- 11.00
   itens[33] <- "Batata frita grande"
   precos[33] <- 14.00
   itens[34] <- "Batata cheddar"
   precos[34] <- 18.00
   itens[35] <- "Batata bacon"
   precos[35] <- 20.00
   itens[36] <- "Batata rustica"
   precos[36] <- 16.00
   itens[37] <- "Aneis de cebola"
   precos[37] <- 14.00
   itens[38] <- "Mandioca frita"
   precos[38] <- 12.00
   itens[39] <- "Polenta frita"
   precos[39] <- 12.00
   itens[40] <- "Nuggets 6 unidades"
   precos[40] <- 10.00
   itens[41] <- "Nuggets 10 unidades"
   precos[41] <- 15.00
   itens[42] <- "Isca de frango"
   precos[42] <- 18.00
   itens[43] <- "Frango empanado"
