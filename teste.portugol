   itens[54] <- "Pastel de palmito"
   precos[54] <- 10.00
   itens[55] <- "Empada de frango"
   precos[55] <- 10.00
   itens[56] <- "Empada de palmito"
   precos[56] <- 9.00
   itens[57] <- "Esfiha de carne"
   precos[57] <- 9.00
   itens[58] <- "Esfiha de queijo"
   precos[58] <- 9.00
   itens[59] <- "Esfiha de frango"
   precos[59] <- 9.00
   itens[60] <- "Enroladinho de queijo"
   precos[60] <- 9.00

   // Pizzas
   itens[61] <- "Pizza mussarela"
   precos[61] <- 32.00
   itens[62] <- "Pizza calabresa"
   precos[62] <- 34.00
   itens[63] <- "Pizza frango"
   precos[63] <- 35.00
   itens[64] <- "Pizza quatro queijos"
   precos[64] <- 39.00
   itens[65] <- "Pizza portuguesa"
   precos[65] <- 36.00
   itens[66] <- "Pizza marguerita"
   precos[66] <- 35.00
   itens[67] <- "Pizza pepperoni"
   precos[67] <- 40.00
   itens[68] <- "Pizza bacon"
   precos[68] <- 38.00
   itens[69] <- "Pizza milho"
   precos[69] <- 32.00
   itens[70] <- "Pizza vegetariana"
   precos[70] <- 35.00

   // Hot dogs e sanduiches
   itens[71] <- "Hot dog simples"
   precos[71] <- 12.00
   itens[72] <- "Hot dog completo"
   precos[72] <- 16.00
   itens[73] <- "Hot dog bacon"
   precos[73] <- 18.00
   itens[74] <- "Hot dog calabresa"
   precos[74] <- 18.00
   itens[75] <- "Hot dog cheddar"
   precos[75] <- 19.00
