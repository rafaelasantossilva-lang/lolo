   // Cafes e outras bebidas
   itens[81] <- "Cafe pequeno"
   precos[81] <- 5.00
   itens[82] <- "Cafe com leite"
   precos[82] <- 7.00
   itens[83] <- "Chocolate quente"
   precos[83] <- 9.00
   itens[84] <- "Cha gelado"
   precos[84] <- 7.00
   itens[85] <- "Milk-shake chocolate"
   precos[85] <- 16.00
   itens[86] <- "Milk-shake morango"
   precos[86] <- 16.00
   itens[87] <- "Milk-shake baunilha"
   precos[87] <- 16.00
   itens[88] <- "Refrigerante lata"
   precos[88] <- 6.00
   itens[89] <- "Refrigerante 600ml"
   precos[89] <- 8.00
   itens[90] <- "Agua mineral"
   precos[90] <- 4.00

   // Sobremesas
   itens[91] <- "Agua com gas"
   precos[91] <- 5.00
   itens[92] <- "Chopp sem alcool"
   precos[92] <- 8.00
   itens[93] <- "Salada de frutas"
   precos[93] <- 12.00
   itens[94] <- "Acai pequeno"
   precos[94] <- 15.00
   itens[95] <- "Acai grande"
   precos[95] <- 18.00
   itens[96] <- "Sorvete chocolate"
   precos[96] <- 8.00
   itens[97] <- "Sorvete morango"
   precos[97] <- 8.00
   itens[98] <- "Sorvete baunilha"
   precos[98] <- 8.00
   itens[99] <- "Brownie"
   precos[99] <- 10.00
   itens[100] <- "Pudim"
   precos[100] <- 12.00

   total <- 0.00

   para i de 1 ate 100 faca
      quantidades[i] <- 0
   fimpara

   repita
      escreval("")
      escreval("========================================")
      escreval("       LANCHONETE SABOR E CIA")
      escreval("========================================")
      escreval("Digite 0 para finalizar o pedido.")
      escreval("")

      para i de 1 ate 100 faca
         escreval(i, " - ", itens[i], " | R$ ", precos[i]:5:2)
      fimpara

      escreva("")
      escreva("Escolha o numero do item: ")
      leia(opcao)

      se opcao <> 0 entao
         se opcao >= 1 e opcao <= 100 entao
            escreva("Digite a quantidade de ", itens[opcao], ": ")
            leia(quantidade)

            se quantidade > 0 entao
               quantidades[opcao] <- quantidades[opcao] + quantidade
               total <- total + (precos[opcao] * quantidade)
               escreval("Item adicionado ao pedido!")
            senao
               escreval("A quantidade deve ser maior que zero.")
            fimse
         senao
            escreval("Opcao invalida. Escolha um numero de 1 a 100.")
         fimse
      fimse
   ate opcao = 0

   escreval("")
   escreval("============= RESUMO DO PEDIDO =========")
   para i de 1 ate 100 faca
      se quantidades[i] > 0 entao
         escreval(quantidades[i], " x ", itens[i], " = R$ ", (precos[i] * quantidades[i]):5:2)
      fimse
   fimpara
   escreval("----------------------------------------")
   escreval("TOTAL: R$ ", total:5:2)
   escreval("Obrigado pela preferencia!")

fimalgoritmo
