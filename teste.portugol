algoritmo "Lanchonete Sabor e Cia"

var
   itens: vetor[1..100] de caractere
   precos: vetor[1..100] de real
   quantidades: vetor[1..100] de inteiro
   opcao, quantidade, i: inteiro
   total: real

inicio
   // Bebidas e sucos
   itens[1] <- "Suco de laranja"
