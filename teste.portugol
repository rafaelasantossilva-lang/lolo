   itens[44] <- "Bolinho de queijo"
   precos[44] <- 14.00
   itens[45] <- "Bolinho de carne"
   precos[45] <- 12.00

   // Salgados
   itens[46] <- "Coxinha"
   precos[46] <- 8.00
   itens[47] <- "Coxinha com catupiry"
   precos[47] <- 10.00
   itens[48] <- "Risole de presunto"
   precos[48] <- 8.00
   itens[49] <- "Kibe"
